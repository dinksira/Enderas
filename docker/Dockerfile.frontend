FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY frontend frontend

RUN npm ci

ARG VITE_API_BASE_URL=https://api.example.com/api
ARG VITE_API_V1_PREFIX=/v1
ARG VITE_ADMIN_APP_URL=https://admin.example.com
ARG VITE_APP_KIND=public
ARG VITE_IOS_APP_URL=
ARG VITE_ANDROID_APP_URL=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_V1_PREFIX=$VITE_API_V1_PREFIX
ENV VITE_ADMIN_APP_URL=$VITE_ADMIN_APP_URL
ENV VITE_APP_KIND=$VITE_APP_KIND
ENV VITE_IOS_APP_URL=$VITE_IOS_APP_URL
ENV VITE_ANDROID_APP_URL=$VITE_ANDROID_APP_URL

RUN npm run build -w frontend

FROM nginx:1.27-alpine

COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
