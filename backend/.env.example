# Server
NODE_ENV=development
PORT=3000

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enderass_auction
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_URL=redis://127.0.0.1:6379
RBAC_INVALIDATE_CHANNEL=rbac:invalidate
RBAC_ROLE_CACHE_TTL_SECONDS=86400
RBAC_USER_CACHE_TTL_SECONDS=300

# JWT — access token max 15 minutes
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Client
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# ALLOWED_ORIGINS=https://www.enderas.et,https://admin.enderas.et

# Auction lifecycle
AUCTION_AUTO_CLOSE_ENABLED=true
AUCTION_AUTO_CLOSE_INTERVAL_MS=60000

# File Storage
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=uploads
STORAGE_MAX_FILE_SIZE=5242880
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Test seed media lives in seed-assets/ (committed). Rebuild with: npm run seed-assets:build
