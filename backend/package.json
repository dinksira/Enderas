{
  "name": "enderas-auction-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db": "node --env-file=.env scripts/db/cli.mjs",
    "db:test": "node --env-file=.env scripts/db/cli.mjs setup test",
    "db:test:reseed": "node --env-file=.env scripts/db/cli.mjs reseed test",
    "db:setup": "node --env-file=.env scripts/db/cli.mjs setup normal",
    "db:setup:reseed": "node --env-file=.env scripts/db/cli.mjs reseed normal",
    "seed-assets:build": "node scripts/db/lib/build-seed-assets.mjs",
    "test": "node --test tests/rbac.policy.test.js",
    "test:rbac": "node --test tests/rbac.policy.test.js",
    "test:auction-flow": "node --env-file=.env scripts/run-auction-flow-test.mjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "i18n": "^0.15.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3",
    "sharp": "^0.35.3"
  }
}
