{
  "name": "enderas-auction-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db": "node --env-file=.env scripts/db/cli.mjs",
    "db:help": "npm run db -- help",
    "db:migrate": "node --env-file=.env scripts/db/cli.mjs migrate",
    "db:patch-bid-drafts": "node --env-file=.env scripts/apply-bid-drafts-schema.mjs",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:test": "npm run db -- setup test",
    "db:test-reset": "npm run db -- reset test",
    "db:test-seed": "npm run db -- seed test",
    "db:test-seed:auctions": "npm run db -- seed test --only=auctions",
    "db:test-reseed": "npm run db -- reseed test",
    "db:setup": "npm run db -- setup normal",
    "db:setup-reset": "npm run db -- reset normal",
    "db:seed": "npm run db -- seed normal",
    "db:seed:auctions": "npm run db -- seed test --only=auctions",
    "db:reseed": "npm run db -- reseed normal",
    "db:reset": "npm run db -- reset normal",
    "test": "node --test tests/rbac.policy.test.js",
    "test:rbac": "node --test tests/rbac.policy.test.js",
    "test:auction-flow": "node --env-file=.env scripts/run-auction-flow-test.mjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "i18n": "^0.15.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
